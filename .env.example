# Mantener true hasta verificar mensajes y permisos de republicacion.
DRY_RUN=true
SOURCE_AUTHORIZED=true
ALLOW_FALLBACK=true
# telegram_draft no usa la API de X. x_api es opcional y de pago.
DELIVERY=telegram_draft
# Chat privado del operador: primero enviar /start al bot.
TELEGRAM_REVIEW_CHAT_ID=
TIMEZONE=America/Mexico_City
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# En grupos: IDs del tipster separados por coma. En canales puede quedar vacio.
TELEGRAM_SENDER_IDS=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
CTA_URL=https://t.me/luckybetpicksfree
MIN_LEAD_MINUTES=30
MAX_POSTS_PER_DAY=3
MIN_GAP_MINUTES=30
# immediate o slots. Slots son hipotesis a medir, no horas optimas demostradas.
FREE_MODE=immediate
FREE_SLOTS=11:00,13:00,14:30
FALLBACK_TIME=15:00
FALLBACK_GRACE_MINUTES=15
# Imagen -> enlace -> etiqueta del mismo remitente y tema, hasta 5 minutos.
BUNDLE_WINDOW_SECONDS=300
# Esperar a que lleguen los mensajes separados antes de preparar el borrador.
BUNDLE_SETTLE_SECONDS=90
